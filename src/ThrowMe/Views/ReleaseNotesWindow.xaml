<Window x:Class="ThrowMe.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrowMe 업데이트"
        Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontFamily="Pretendard, Malgun Gothic" Icon="/Resources/ThrowMe.ico">

    <Border CornerRadius="16" Background="{StaticResource WinBg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Grid Grid.Row="0" Background="{StaticResource SideBg}" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="16" Height="16">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A8F0DD" Offset="0"/>
                                <GradientStop Color="#8B6FD6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="ThrowMe 업데이트" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                               FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="OnClose" Width="42" Height="42" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                        FontSize="13" Cursor="Hand"/>
            </Grid>

            <!-- 헤더: 버전 배지 + 제목 -->
            <StackPanel Grid.Row="1" Margin="24,20,24,0">
                <Border HorizontalAlignment="Left" CornerRadius="6" Background="{StaticResource Accent}" Padding="9,3">
                    <TextBlock x:Name="VersionBadge" Text="v1.0.0" Foreground="White"
                               FontSize="11.5" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="HeadlineText" Style="{StaticResource H1}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Text="새 버전으로 업데이트되었습니다"/>
                <TextBlock Text="이번 업데이트에서 달라진 점이에요." Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 노트 본문 -->
            <ScrollViewer Grid.Row="2" Margin="24,16,16,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NotesPanel" Margin="0,0,8,0"/>
            </ScrollViewer>

            <!-- 하단 -->
            <Grid Grid.Row="3" Margin="24,18,24,20">
                <StackPanel x:Name="MuteRow" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="MuteToggle" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    <TextBlock Text="다음부터 알리지 않기" Style="{StaticResource RowDesc}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" Content="확인" Click="OnClose"
                        HorizontalAlignment="Right" MinWidth="96"/>
            </Grid>
        </Grid>
    </Border>
</Window>
