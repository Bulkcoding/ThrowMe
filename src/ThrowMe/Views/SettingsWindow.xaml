<Window x:Class="ThrowMe.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ThrowMe 설정"
        Width="1100" Height="740"
        WindowStyle="None" ResizeMode="CanResize"
        MinWidth="900" MinHeight="560"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="True" FontFamily="Pretendard, Malgun Gothic" Icon="/Resources/ThrowMe.ico"

        AllowsTransparency="False" Background="{StaticResource WinBg}">
    <!-- 크기 조절(CanResize)을 켜면 WPF 가 창 위쪽에 밝은 리사이즈 프레임(#F3F3F3)을 그려
         제목줄 위에 흰 줄이 생긴다. WindowChrome 으로 그 프레임을 없애고,
         가장자리 리사이즈 영역만 남긴다. CaptionHeight=0 이라 드래그는 기존 제목줄 핸들러가 그대로 맡는다. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <!-- 모서리·그림자·1px 테두리는 OS(DWM) 가 그린다 → 코드비하인드의 DwmChrome.AttachTo(this).
         그래서 AllowsTransparency 는 반드시 false 이고(true 면 레이어드 창이 되어 DWM 이 손을 뗀다),
         창 배경도 Transparent 가 아니라 실제 색(WinBg)이어야 한다. 그림자용 여백·Clip 도 필요 없다. -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Grid Grid.Row="0" Background="{StaticResource SideBg}" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="16" Height="16">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A8F0DD" Offset="0"/>
                                <GradientStop Color="#8B6FD6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="ThrowMe 설정" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                               FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="OnClose" Width="42" Height="42" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                        FontSize="13" Cursor="Hand"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideCol" Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <Border Grid.Column="0" Background="{StaticResource SideBg}">
                    <DockPanel>
                        <!-- 접기/펴기. 좁은 화면에서 목록을 아이콘만 남기고 접는다. -->
                        <Button DockPanel.Dock="Top" x:Name="SideToggleBtn" Click="OnToggleSidebar"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Left" Margin="14,10,0,0" Padding="6"
                                Foreground="{StaticResource MutedBrush}"
                                ToolTip="목록 접기 / 펴기">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE700;" Width="18"/>
                        </Button>

                        <!-- 앱 이름(선택 대상 아님) -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,8,12,10">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="NavTextApp" Text="ThrowMe" Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 접었을 때 항목이 폭을 넘어 가로 스크롤바가 생기지 않게 막는다. -->
                        <ListBox x:Name="Nav" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnNavChanged" ItemContainerStyle="{StaticResource NavItem}">
                            <ListBoxItem IsSelected="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;"/>
                                    <TextBlock x:Name="NavText0" Text="일반" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE790;"/>
                                    <TextBlock x:Name="NavText1" Text="테마" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE767;"/>
                                    <TextBlock x:Name="NavText2" Text="소리" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE765;"/>
                                    <TextBlock x:Name="NavText3" Text="단축키" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7F4;"/>
                                    <TextBlock x:Name="NavText4" Text="멀티 PC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7C3;"/>
                                    <TextBlock x:Name="NavText5" Text="업데이트 노트" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 내용 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
                    <Grid>
                        <!-- ══ 일반 ══ -->
                        <StackPanel x:Name="PanelGeneral">
                            <TextBlock Text="일반" Style="{StaticResource H1}"/>
                            <TextBlock Text="슬라임의 물리와 동작, 시스템 동작을 조절합니다."
                                       Style="{StaticResource RowDesc}" Margin="0,4,0,18"/>

                            <!-- 좌우 2단: 왼쪽은 공의 성질, 오른쪽은 시스템·업데이트 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ── 왼쪽 열 ── -->
                                <StackPanel Grid.Column="0">

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE9D9;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="모양 / 물리"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="크기" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="슬라임 크기를 조절합니다."/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="48" Maximum="180" Value="{Binding SlimeSizeBase}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding SlimeSizeBase, StringFormat={}{0:0}px}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Bounce Power" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock x:Name="RestitutionDesc" Style="{StaticResource InfoIcon}" ToolTip="벽에 튕기는 반발력."/>
                                                </StackPanel>
                                                <Grid x:Name="RestitutionRow" Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1.0" Value="{Binding Restitution}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Restitution, StringFormat={}{0:P0}}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Slime Softness" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="말랑말랑한 정도."/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" Value="{Binding Softness}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Softness, StringFormat={}{0:P0}}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="던지기 가중치" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="마우스 속도에 곱하는 가중치."/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0.3" Maximum="20.0" Value="{Binding ThrowPower}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ThrowPower, StringFormat={}{0:0.0}x}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="최고 속도" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="공이 낼 수 있는 최대 속도 제한입니다."/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0.25" Maximum="4.0" Value="{Binding SpeedLimitScale}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding SpeedLimitScale, StringFormat={}{0:0.00}x}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="감속" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock x:Name="SlowdownDesc" Style="{StaticResource InfoIcon}" ToolTip="날아가던 공이 느려지는 정도입니다."/>
                                                </StackPanel>
                                                <Grid x:Name="SlowdownRow" Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="3.0" Value="{Binding SlowdownScale}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding SlowdownScale, StringFormat={}{0:0.00}x}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="무한 튕기기" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="힘을 잃지 않고 계속 튕겨 다닙니다. 감속과 반발력이 고정됩니다."/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding InfiniteBounce}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ── 자동 이동 ── -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE81D;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="자동 이동"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AutoMoveLockedNotice" Visibility="Collapsed" Margin="0,-6,0,12" TextWrapping="Wrap"
                                                       Style="{StaticResource RowDesc}"
                                                       Text="슬라임 테마에서만 쓸 수 있어요. 테마 탭에서 슬라임을 고르면 켤 수 있습니다."/>
                                            <StackPanel x:Name="AutoMoveRows">

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="움직임" Style="{StaticResource RowLabel}"/>
                                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="무한 튕기기와 달리 느리게 끊임없이 움직입니다.&#10;· 기어다니기 — 화면을 느릿느릿 돌아다닙니다.&#10;· 작업표시줄 걷기 — 화면 아래에 붙어 좌우로 걷습니다.&#10;· 커서 따라가기 — 마우스 오른쪽 아래를 천천히 따라옵니다.&#10;뒤 두 가지는 작업을 가리지 않도록 슬라임 클릭이 막힙니다."/>
                                                    </StackPanel>
                                                    <TextBlock Text="스스로 움직이는 방식." Style="{StaticResource RowDesc}"/>
                                                </StackPanel>
                                                <ComboBox x:Name="AutoMoveBox" Grid.Column="1" VerticalAlignment="Center"
                                                          Style="{StaticResource DarkCombo}"
                                                          SelectionChanged="OnAutoMoveChanged">
                                                    <ComboBoxItem Content="끔"/>
                                                    <ComboBoxItem Content="기어다니기"/>
                                                    <ComboBoxItem Content="작업표시줄 걷기"/>
                                                    <ComboBoxItem Content="커서 따라가기"/>
                                                </ComboBox>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="이동 속도" Style="{StaticResource RowLabel}"/>
                                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="자동으로 움직일 때의 속도입니다. 올리면 걸음 빠르기는 그대로 두고 한 걸음 거리가 늘어납니다.&#10;커서 따라가기는 예외로, 멀수록 걸음도 빨라집니다."/>
                                                    </StackPanel>
                                                    <TextBlock Text="초당 몇 픽셀씩 갈지." Style="{StaticResource RowDesc}"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}"
                                                            Minimum="5" Maximum="120" Value="{Binding AutoMoveSpeed}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding AutoMoveSpeed, StringFormat={}{0:0}}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="돌아다닐 모니터" Style="{StaticResource RowLabel}"/>
                                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="자동 이동을 한 모니터 안에만 가둡니다.&#10;던지기에는 적용되지 않으므로, 손으로는 어느 모니터로든 보낼 수 있습니다."/>
                                                    </StackPanel>
                                                    <TextBlock Text="자동 이동에만 적용됩니다." Style="{StaticResource RowDesc}"/>
                                                </StackPanel>
                                                <ComboBox x:Name="AutoMoveMonitorBox" Grid.Column="1" VerticalAlignment="Center"
                                                          Style="{StaticResource DarkCombo}"
                                                          SelectionChanged="OnAutoMoveMonitorChanged"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="따라가는 방식" Style="{StaticResource RowLabel}"/>
                                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="· 따라오기 — 커서 쪽으로 한 걸음씩 뛰어 쫓아옵니다. 멀수록 걸음이 빨라집니다.&#10;· 키링 — 커서에 매달려 흔들립니다. 커서를 움직이면 뒤로 늘어졌다가 아래로 모입니다."/>
                                                    </StackPanel>
                                                    <TextBlock Text="커서 따라가기 전용." Style="{StaticResource RowDesc}"/>
                                                </StackPanel>
                                                <ComboBox x:Name="CursorStyleBox" Grid.Column="1" VerticalAlignment="Center"
                                                          Style="{StaticResource DarkCombo}"
                                                          SelectionChanged="OnCursorStyleChanged">
                                                    <ComboBoxItem Content="따라오기"/>
                                                    <ComboBoxItem Content="키링"/>
                                                </ComboBox>
                                            </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7C9;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="동작"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Throw Mode (던지기)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ThrowMode}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Punch Mode (때리기/열기)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding PunchMode}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="항상 위(Always on Top)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AlwaysOnTop}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="일시 정지" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Paused}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="슬라임 표시" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding SlimeVisible}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 당구공 스킨일 때만 보인다 -->
                                    <Border x:Name="BilliardSection" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xEB52;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="당구"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="큐대로 때리기" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="공 근처를 눌러 큐대를 당겨 밀어서 발사합니다."/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding CueStickMode}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── 오른쪽 열 ── -->
                                <StackPanel Grid.Column="2">

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7F4;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="시스템"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="작업표시줄 표시" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="Alt+Tab 목록에 ThrowMe 를 표시합니다."/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ShowInTaskbar}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="클릭 여유" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="공 주변 클릭 허용 범위"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="120" Value="{Binding ClickMarginPx}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ClickMarginPx, StringFormat={}{0:0}px}"/>
                                                </Grid>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="알림 표시" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="공이 다른 PC로 넘어가면 우측 하단에 알려줍니다."/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ShowToasts}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="사용법 힌트" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="사용 중간중간 우측 하단에 짧게 알려줍니다."/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ShowUsageTips}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE72C;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="업데이트"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="UpdateInfoText" Grid.Column="0" Style="{StaticResource RowDesc}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"
                                                           Text="앱을 켤 때 새 버전이 있으면 자동으로 받아 적용하고 다시 시작합니다."/>
                                                <Button Grid.Column="1" Style="{StaticResource OutlineButton}"
                                                        VerticalAlignment="Center" Click="OnGoToNotes">
                                                    <TextBlock Text="업데이트 노트 보기"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ── 초기화(전체 폭) ── -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7A7;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="초기화"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowDesc}" Margin="0"
                                                       Text="공이 화면 밖으로 사라졌거나 설정이 꼬였을 때 되돌립니다."/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="설정 초기화는 테마·소리·단축키를 모두 기본값으로 돌립니다. 방 코드·비밀번호와 직접 그린 그림 파일은 지워지지 않습니다."/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="이 설정 창이 떠 있을 때 Ctrl + R 을 눌러도 설정 초기화가 실행됩니다."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource OutlineButton}" MinWidth="150" Click="OnResetPosition">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE707;"/>
                                                    <TextBlock Text="위치 초기화"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AccentOutlineButton}" MinWidth="150" Margin="12,0,0,0"
                                                    Click="OnResetSettings">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BtnIcon}" Text="&#xE713;"/>
                                                    <TextBlock Text="설정 초기화"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── CLI 연동 ── -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xE756;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="CLI 연동 (Claude Code)"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="상태 수신" Style="{StaticResource RowLabel}"/>
                                                <TextBlock Style="{StaticResource InfoIcon}" ToolTip="Claude Code 훅이 보내는 이벤트를 이 PC 안(127.0.0.1)에서만 받습니다.&#10;펫 테마가 생각 중·작업 중·승인 대기·오류 동작으로 반응합니다."/>
                                            </StackPanel>
                                            <TextBlock Text="Claude Code 작업 상태를 펫 동작에 반영합니다." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding CliLinkEnabled}"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Claude Code 훅" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                                       Text="사용자 설정(~/.claude/settings.json)에 상태 전송 훅을 넣습니다. 다른 도구의 훅은 건드리지 않으며, 처음 한 번 백업을 남깁니다. 열려 있는 Claude Code 는 다시 시작해야 반영됩니다."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="InstallHooksBtn" Style="{StaticResource OutlineButton}" MinWidth="110" Content="훅 등록" Click="OnInstallHooks"/>
                                            <Button x:Name="UninstallHooksBtn" Style="{StaticResource GhostButton}" MinWidth="90" Margin="8,0,0,0" Content="훅 해제" Click="OnUninstallHooks"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="CliStatusText" Style="{StaticResource RowDesc}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 테마 ══ -->
                        <StackPanel x:Name="PanelTheme" Visibility="Collapsed">
                            <TextBlock Text="테마" Style="{StaticResource H1}"/>
                            <!-- 방장이 아니면 방장의 테마가 강제 적용되므로 이 탭을 막는다. -->
                            <Border x:Name="ThemeLockedNotice" Visibility="Collapsed"
                                    CornerRadius="10" Background="{StaticResource CardBg}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    Padding="14,12" Margin="0,10,0,4">
                                <StackPanel>
                                    <TextBlock Text="방장이 정한 테마가 적용됩니다"
                                               Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="같은 방에서는 방장의 테마·가중치·그림이 모두에게 똑같이 적용됩니다. 직접 바꾸려면 방을 나가세요."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="슬라임 스킨을 고르세요. 카드를 눌러 미리보고 바로 적용됩니다." Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="ThemeCards" Margin="0,16,0,0"/>

                            <!-- 펫 테마: Codex Pet zip 가져오기 + 가져온 펫 카드 -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7F4;"/>
                                        <TextBlock Text="펫 테마 (Codex Pet)" Style="{StaticResource CardTitle}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                               Text="Codex Pet 형식의 zip(pet.json + 스프라이트시트)을 가져오면 테마로 추가됩니다. 펫은 Claude Code 작업 상태에 따라 생각·작업·승인 대기·실패 동작을 보여 줍니다(일반 → CLI 연동에서 훅을 등록하세요). 던지면 진행 방향으로 달립니다."/>
                                    <WrapPanel x:Name="PetCards" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="zip 가져오기" MinWidth="120" Height="36" Click="OnImportPet"/>
                                        <TextBlock x:Name="PetEmptyText" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Text="가져온 펫이 없습니다."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 커스텀 이미지: 지원 테마(슬라임·당구공)를 고른 경우에만 표시 -->
                            <Border x:Name="CustomImageSection" Style="{StaticResource Card}"
                                    Visibility="Collapsed" Margin="0,18,0,0">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE91B;"/>
                                    <TextBlock x:Name="CustomImageHeader" Text="커스텀 이미지" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="이 테마의 공 표면에 내 이미지를 덧씌우거나, 직접 그려서 올릴 수 있습니다. 테마별로 따로 저장됩니다."
                                           Style="{StaticResource RowDesc}"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 현재 이미지 미리보기(공 모양) -->
                                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="10"
                                            Background="{StaticResource WinBg}" Margin="0,0,14,0">
                                        <Grid x:Name="CustomPreviewHost"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CustomImageName" Text="(없음)" Style="{StaticResource RowLabel}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="불러오기"
                                                    MinWidth="94" Height="36" Margin="0,0,8,0" Click="OnLoadSkinImage"/>
                                            <Button Style="{StaticResource GhostButton}" Content="그리기"
                                                    MinWidth="84" Height="36" Margin="0,0,8,0" Click="OnDrawSkinImage"/>
                                            <Button x:Name="RemoveImageBtn" Style="{StaticResource GhostButton}" Content="제거"
                                                    MinWidth="72" Height="36" Click="OnRemoveSkinImage"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="덧씌우기 사용" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="끄면 이미지를 보관한 채 원래 스킨만 보입니다."/>
                                                </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                              IsChecked="{Binding SkinImageEnabled}"/>
                                </Grid>

                                <Grid Margin="0,12,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="이미지 크기" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="100% = 공에 꽉 맞춤."/>
                                                </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0.3" Maximum="1.6"
                                                Value="{Binding SkinImageScale}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                                   Text="{Binding SkinImageScale, StringFormat={}{0:P0}}"/>
                                    </Grid>
                                </Grid>
                              </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 소리 ══ -->
                        <StackPanel x:Name="PanelSound" Visibility="Collapsed">
                            <TextBlock Text="소리 / 효과" Style="{StaticResource H1}"/>
                            <TextBlock Text="효과음과 충돌 파티클을 설정합니다."
                                       Style="{StaticResource RowDesc}" Margin="0,4,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE767;"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="소리"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Sound Effects" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="부딪힐 때 효과음을 냅니다."/>
                                                </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding SoundEnabled}"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Volume" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="효과음 크기."/>
                                                </StackPanel>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" Value="{Binding SoundVolume}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding SoundVolume, StringFormat={}{0:P0}}"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE945;"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="효과"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Particles (충돌 파티클)" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="벽에 부딪힐 때 조각이 튑니다."/>
                                                </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ParticlesEnabled}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ══ 단축키 ══ -->
                        <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
                            <TextBlock Text="단축키" Style="{StaticResource H1}"/>
                            <TextBlock Text="전역 단축키로 슬라임을 다룹니다." Style="{StaticResource RowDesc}" Margin="0,4,0,18"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                <TextBlock Text="잡기와 숨기기는 반드시 조합키로 지정합니다. 왼쪽 칸에 수정자(Ctrl·Shift·Alt·Win), 오른쪽 칸에 키 또는 마우스 클릭을 넣으세요."
                                           Style="{StaticResource RowDesc}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="각 칸을 누른 뒤 원하는 것을 누르고, 마지막에 '저장'을 눌러야 적용됩니다. 수정자 없이 단독 키로 두면 평소 타이핑과 클릭까지 가로채기 때문에 막아 두었습니다."
                                           Style="{StaticResource RowDesc}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="잡기" Style="{StaticResource Section}"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="슬라임 잡기(커서로 회수)" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="날아가는 슬라임을 마우스 커서 위치로 즉시 데려와 잡습니다."/>
                                                </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CatchModBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindCatchMod"/>
                                        <TextBlock Text="+" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        <Button x:Name="CatchKeyBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindCatchKey"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="농구공 조준" Style="{StaticResource Section}"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="조준 단축키 (기본 Shift)" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="농구공을 잡은 채 이 키를 누르고 뒤로 끌면 포물선 유도선이 나타나고, 마우스를 떼면 그 궤적으로 날아갑니다.&#10;'변경' 후 원하는 키를 누르면 바로 적용됩니다."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="AimKeyBtn" Style="{StaticResource GhostButton}"
                                            MinWidth="160" VerticalAlignment="Center" Click="OnRebindAimKey"/>
                                </Grid>
                                <TextBlock Text="종이비행기 바람" Style="{StaticResource Section}"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="바람 단축키 (기본 Ctrl + Space)" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="종이비행기가 날고 있을 때 누르면 아래에서 바람이 불어 더 오래 활공합니다.&#10;왼쪽 Ctrl 칸은 고정이라 바꿀 수 없고, 오른쪽 칸만 누르면 키를 바꿀 수 있습니다. 날고 있는 동안에만 잡으므로 평소에는 다른 앱이 그대로 씁니다."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- 수정자 칸은 Ctrl 고정 — 잡기·숨기기와 같은 모양으로 두되 누를 수 없게 한다. -->
                                        <Button x:Name="WindModBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Content="Ctrl" IsEnabled="False" Opacity="0.6"
                                                ToolTip="바람 단축키의 수정자는 Ctrl 로 고정입니다."/>
                                        <TextBlock Text="+" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        <Button x:Name="WindKeyBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindWindKey"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="빠르게 숨기기" Style="{StaticResource Section}"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="슬라임 숨기기 / 다시 보이기" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Style="{StaticResource InfoIcon}" ToolTip="슬라임과 놓아둔 당구공·이펙트를 한 번에 감춥니다. 같은 키를 다시 누르면 되돌아옵니다."/>
                                                </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="HideModBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindHideMod"/>
                                        <TextBlock Text="+" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        <Button x:Name="HideKeyBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindHideKey"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="설정 열기" Style="{StaticResource Section}"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="설정 창 열기 (기본 Space + Tab)" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="앞 칸의 키를 누르고 있는 동안 뒤 칸의 키를 누르면 설정이 열립니다.&#10;여기만 두 칸 모두 아무 키나 넣을 수 있습니다(수정자가 아니어도 됩니다).&#10;자동 이동 중에는 슬라임을 클릭할 수 없으므로 이 단축키가 설정으로 가는 길입니다.&#10;순서대로 치는 평범한 타이핑은 가로채지 않습니다."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="OpenSetHoldBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindOpenSetHold"/>
                                        <TextBlock Text="+" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        <Button x:Name="OpenSetKeyBtn" Style="{StaticResource GhostButton}"
                                                MinWidth="104" Click="OnRebindOpenSetKey"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 저장: 우측 하단에 여유있게 -->
                                <Button x:Name="SaveBtn" Style="{StaticResource AccentButton}" Content="저장"
                                        MinWidth="120" Height="38" HorizontalAlignment="Right"
                                        Margin="0,28,0,0" Click="OnSaveHotkey" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 멀티 PC ══ -->
                        <StackPanel x:Name="PanelNetwork" Visibility="Collapsed">
                            <TextBlock Text="멀티 PC" Style="{StaticResource H1}"/>
                            <TextBlock Text="로그인한 여러 PC를 연결해, 공이 화면 밖으로 나가면 다른 PC로 넘어갑니다. (인터넷 너머도 가능)"
                                       Style="{StaticResource RowDesc}" Margin="0,4,0,18"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <!-- NetStatus 는 설명이 아니라 코드가 갱신하는 '현재 연결 상태' 다.
                                         ⓘ 아이콘으로 바꾸면 아이콘 글꼴로 한글이 렌더돼 □□ 로 보인다. -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="멀티 PC 사용" Style="{StaticResource RowLabel}"/>
                                        <TextBlock x:Name="NetStatus" Text="꺼짐" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NetEnabled" Grid.Column="1" Style="{StaticResource Toggle}"/>
                                </Grid>

                                <!-- 서버 주소는 앱에 내장(AuthService.DefaultServerBaseUrl). 사용자 입력 없음.
                                     개발용 오버라이드는 relay.json 의 serverBaseUrl 또는 실행 인자로 지정. -->
                                <TextBlock x:Name="NetServerInfo" Style="{StaticResource RowDesc}" Margin="0,8,0,0"/>

                                <!-- ── 탭: 방 생성 / 입장 ── -->
                                <Grid Margin="0,18,0,0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TabCreate" Grid.Column="0" Content="방 생성" GroupName="RoomMode"
                                                 Style="{StaticResource SubTab}" IsChecked="True" Checked="OnRoomTabChanged"/>
                                    <RadioButton x:Name="TabJoin" Grid.Column="2" Content="입장" GroupName="RoomMode"
                                                 Style="{StaticResource SubTab}" Checked="OnRoomTabChanged"/>
                                </Grid>

                                <!-- 방 생성: 방장이 되어 배치를 결정한다 -->
                                <StackPanel x:Name="PaneCreate" Margin="0,14,0,0">
                                    <TextBlock Text="새 방을 만들면 내가 방장이 되고, 파티 순서(배치)를 정할 수 있습니다."
                                               Style="{StaticResource RowDesc}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="방 코드" Style="{StaticResource RowLabel}"/>
                                            <TextBox x:Name="CreateRoom" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="GenCodeBtn" Style="{StaticResource GhostButton}"
                                                Content="코드 생성" MinWidth="110" Height="38" VerticalAlignment="Bottom"
                                                Click="OnGenerateCode"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="비밀번호" Style="{StaticResource RowLabel}"/>
                                            <PasswordBox x:Name="CreateSecret" Style="{StaticResource DarkPassword}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="이 PC 이름" Style="{StaticResource RowLabel}"/>
                                            <TextBox x:Name="CreateNode" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="CreateBtn" Style="{StaticResource AccentButton}" Content="방 만들기"
                                            MinWidth="150" Height="38" HorizontalAlignment="Right" Margin="0,16,0,0"
                                            Click="OnCreateRoom"/>
                                </StackPanel>

                                <!-- 입장: 방장이 만든 방에 참여 -->
                                <StackPanel x:Name="PaneJoin" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBlock Text="방장에게 받은 방 코드와 비밀번호를 입력해 입장합니다. 배치는 방장이 정합니다."
                                               Style="{StaticResource RowDesc}"/>
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="방 코드" Style="{StaticResource RowLabel}"/>
                                        <TextBox x:Name="JoinRoom" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="비밀번호" Style="{StaticResource RowLabel}"/>
                                            <PasswordBox x:Name="JoinSecret" Style="{StaticResource DarkPassword}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="이 PC 이름" Style="{StaticResource RowLabel}"/>
                                            <TextBox x:Name="JoinNode" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="JoinBtn" Style="{StaticResource AccentButton}" Content="입장하기"
                                            MinWidth="150" Height="38" HorizontalAlignment="Right" Margin="0,16,0,0"
                                            Click="OnJoinRoom"/>
                                </StackPanel>

                                <!-- ── 방 겉모습 ──
                                     별도 콤보를 두지 않는다. 방장이 '테마' 탭에서 고른 테마·가중치·그림이
                                     그대로 방 전체에 적용되고, 여기서는 그 내용을 모두가 확인만 한다. -->
                                <StackPanel x:Name="RoomThemePanel" Visibility="Collapsed">
                                    <TextBlock Text="방 겉모습" Style="{StaticResource Section}"/>
                                    <TextBlock x:Name="RoomStyleHint" Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                               Text="방장이 정한 테마가 방 전체에 적용됩니다."/>
                                    <Border CornerRadius="10" Background="{StaticResource CardBg}"
                                            Padding="14,12" Margin="0,10,0,0">
                                        <StackPanel x:Name="RoomStyleSummary"/>
                                    </Border>
                                </StackPanel>

                                <!-- ── 파티원 (좌 → 우 배치) ── -->
                                <TextBlock Text="파티원 (왼쪽 → 오른쪽 배치 순서)" Style="{StaticResource Section}"/>
                                <TextBlock x:Name="PartyHint" Style="{StaticResource RowDesc}"
                                           Text="방에 입장하면 참여자가 표시됩니다."/>
                                <ItemsControl x:Name="PartyList" Margin="0,10,0,0"/>
                                <TextBlock x:Name="PartyChainInfo" Style="{StaticResource RowDesc}" Margin="0,10,0,0"/>

                                <Button x:Name="NetLeaveBtn" Style="{StaticResource GhostButton}" Content="방 나가기"
                                        MinWidth="120" Height="34" HorizontalAlignment="Right" Margin="0,18,0,6"
                                        Click="OnLeaveRoom" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 업데이트 노트 ══ -->
                        <StackPanel x:Name="PanelUpdateNotes" Visibility="Collapsed">
                            <TextBlock Text="업데이트 노트" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="NotesHeaderText" Style="{StaticResource RowDesc}" Margin="0,4,0,18"
                                       TextWrapping="Wrap" Text="버전별로 무엇이 바뀌었는지 볼 수 있습니다."/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="NotesRefreshBtn" Style="{StaticResource GhostButton}"
                                            Content="새로고침" MinWidth="110" Height="34" Click="OnRefreshNotes"/>
                                    <TextBlock x:Name="NotesStatusText" Style="{StaticResource RowDesc}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" Text=""/>
                                </StackPanel>

                                <ItemsControl x:Name="NotesList" Margin="0,16,0,6"/>

                                <!-- 페이지 이동 (한 페이지 5개) -->
                                <StackPanel x:Name="NotesPager" Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,4,0,10"
                                            Visibility="Collapsed">
                                    <Button x:Name="NotesPrevBtn" Style="{StaticResource GhostButton}"
                                            Content="◀ 이전" MinWidth="86" Height="32" Click="OnNotesPrev"/>
                                    <TextBlock x:Name="NotesPageText" Style="{StaticResource RowDesc}"
                                               VerticalAlignment="Center" Margin="14,0,14,0" Text=""/>
                                    <Button x:Name="NotesNextBtn" Style="{StaticResource GhostButton}"
                                            Content="다음 ▶" MinWidth="86" Height="32" Click="OnNotesNext"/>
                                </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
</Window>
