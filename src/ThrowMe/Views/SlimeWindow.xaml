<Window x:Class="ThrowMe.Views.SlimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrowMe"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Icon="/Resources/ThrowMe.ico"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="384" Height="384"
        Left="0" Top="0">

    <Window.Resources>
        <RadialGradientBrush x:Key="SparkBrush">
            <GradientStop Color="#FFFFF6C6" Offset="0.0"/>
            <GradientStop Color="#DDFFE24D" Offset="0.4"/>
            <GradientStop Color="#00FFE24D" Offset="1.0"/>
        </RadialGradientBrush>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource DarkMenu}" Opened="OnMenuOpened">
            <MenuItem Header="설정" Click="OnOpenSettings" Style="{StaticResource DarkMenuItem}" FontWeight="SemiBold"/>
            <MenuItem Header="위치 초기화" Click="OnResetPosition" Style="{StaticResource DarkMenuItem}"/>
            <Separator x:Name="MenuBilliardSep" Style="{StaticResource DarkSeparator}"/>
            <MenuItem x:Name="Menu4Ball" Header="4구 놓기 (빨강2·노랑1)" Click="On4Ball" Style="{StaticResource DarkMenuItem}"/>
            <MenuItem x:Name="Menu3Ball" Header="3구 놓기 (빨강1·노랑1)" Click="On3Ball" Style="{StaticResource DarkMenuItem}"/>
            <MenuItem x:Name="MenuClearBalls" Header="당구공 치우기" Click="OnClearBalls" Style="{StaticResource DarkMenuItem}"/>
            <Separator x:Name="MenuBasketballSep" Style="{StaticResource DarkSeparator}"/>
            <MenuItem x:Name="MenuHoops" Header="농구골대 구현" Click="OnToggleHoops" Style="{StaticResource DarkMenuItem}"/>
            <Separator x:Name="MenuBowlingSep" Style="{StaticResource DarkSeparator}"/>
            <MenuItem x:Name="MenuBowlingStart" Header="볼링하기 🎳" Click="OnBowlingStart" Style="{StaticResource DarkMenuItem}"/>
            <MenuItem x:Name="MenuBowlingReset" Header="핀 다시 세우기" Click="OnBowlingReset" Style="{StaticResource DarkMenuItem}"/>
            <MenuItem x:Name="MenuBowlingExit" Header="볼링 끝내기" Click="OnBowlingExit" Style="{StaticResource DarkMenuItem}"/>
            <Separator Style="{StaticResource DarkSeparator}"/>
            <!-- 현재 버전 표시(누를 수 없는 안내 항목). 텍스트는 코드에서 채운다. -->
            <MenuItem x:Name="MenuVersion" Header="버전" IsEnabled="False"
                      Style="{StaticResource DarkMenuItem}"/>
            <MenuItem Header="종료" Click="OnExit" Style="{StaticResource DarkMenuItem}"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- 창은 슬라임보다 넉넉히 커서(패딩) 주변 이펙트를 그릴 수 있다. -->
    <Grid>

        <!-- 클릭 영역: 공 주변 원형으로만 받는다(크기는 코드에서 SlimeSize + ClickMarginPx).
             레이어드 창은 alpha=0(#00) 픽셀을 OS 단에서 클릭 통과시키므로,
             거의 안 보이는 alpha=1(#01) 로 칠한 이 원 안에서만 클릭이 잡히고 나머지는 통과한다.
             예전에는 창 전체(공의 4배)를 칠해서, 날아가는 동안 보이지 않는 사각형이
             다른 창의 클릭을 삼켰다(설정창 탭이 안 눌리는 문제). -->
        <Ellipse x:Name="HitArea" Fill="#01000000"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- ═══ 스핀 이펙트: 중앙 고정(창 크기와 분리), 설계 캔버스 240 ═══ -->
        <Viewbox x:Name="SpinFxBox" Stretch="Uniform" IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="240" Height="240">
                <Grid x:Name="SpinFx" Width="240" Height="240" Opacity="0">
                    <!-- 반짝이(코드에서 채움, 트윈클). 스핀과 독립된 완만한 자체 회전. -->
                    <Canvas x:Name="SparkLayer" Width="240" Height="240" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SparkRotate"/>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
            </Canvas>
        </Viewbox>

        <!-- ═══ 슬라임 본체: 중앙에 SlimeSize 크기로 고정 ═══ -->
        <Viewbox x:Name="SlimeBox" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- SlimeVisual: 이 Grid 에만 RenderTransform 적용. 비주얼 교체 시 이 안만 바꾸면 됨. -->
            <Grid x:Name="SlimeVisual" Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SlimeScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="SlimeRotate" Angle="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- 그림자(스킨 공통). 종이비행기처럼 둥글지 않은 스킨은 코드에서 숨긴다. -->
                <Ellipse x:Name="CommonShadow" Margin="14,20,14,6" Fill="#33000000">
                    <Ellipse.Effect>
                        <BlurEffect Radius="8"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 스킨 호스트: 코드에서 선택된 스킨(UserControl)을 넣는다. -->
                <ContentControl x:Name="SkinHost"/>

                <!-- ═══ 테마별 커스텀 이미지(덧씌우기) ═══
                     스킨 위에 한 겹 올린다 → 스킨 파일을 건드리지 않고 모든 테마에 적용.
                     공 본체(Margin 6, 지름 84)와 같은 원으로 클립하고, 위에 구면 음영·광택을
                     다시 씌워 "스티커"가 아니라 공 표면처럼 보이게 한다. -->
                <Grid x:Name="CustomImageLayer" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.Clip>
                        <EllipseGeometry Center="48,48" RadiusX="42" RadiusY="42"/>
                    </Grid.Clip>

                    <Image x:Name="CustomImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- 구면 볼륨(가장자리 음영) -->
                    <Ellipse Margin="6">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="0.62"/>
                                <GradientStop Color="#38000000" Offset="0.88"/>
                                <GradientStop Color="#6E000000" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 광택 하이라이트 -->
                    <Ellipse Width="26" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="22,16,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#B0FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- ═══ 스핀 조준(큐대 모드): 공 위 원 + 이동 가능한 점(칠 지점=스핀) ═══ -->
        <Grid x:Name="SpinAim" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse x:Name="SpinCircle" Stroke="#B0FFFFFF" StrokeThickness="1.5" StrokeDashArray="3 3"/>
            <Ellipse Width="14" Height="14" Fill="#E8623D" Stroke="White" StrokeThickness="1.5"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="SpinDotShift"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

    </Grid>
</Window>
