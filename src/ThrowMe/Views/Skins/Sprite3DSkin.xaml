<UserControl x:Class="ThrowMe.Views.Skins.Sprite3DSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="96" Height="96">
            <Ellipse x:Name="Shadow" Width="62" Height="10" Fill="#26000000"
                     VerticalAlignment="Bottom" Margin="0,0,0,3"/>
            <Viewport3D x:Name="Viewport" Width="96" Height="96"
                        IsHitTestVisible="False" ClipToBounds="False">
                <Viewport3D.Camera>
                    <OrthographicCamera Position="0,0,4" LookDirection="0,0,-1"
                                        UpDirection="0,1,0" Width="2.8"/>
                </Viewport3D.Camera>
            </Viewport3D>
        </Grid>
    </Viewbox>
</UserControl>
