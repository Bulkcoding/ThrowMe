<UserControl x:Class="ThrowMe.Views.Skins.PaperPlaneSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <!-- 참고 이미지(image/종이비행기.jpg)의 라인아트 형태를 그대로 옮긴 도형.
         기본 그림은 기수(nose)가 오른쪽 위. 왼쪽으로 날 때는 Mirror(ScaleX=-1)로 뒤집는다.
           N(90,23)  기수
           A(6,34)   위쪽 날개 뒤끝
           B(19.6,42.3) 왼쪽 접힘점
           C(27.9,45.2) 중앙 접힘 아래점
           D(24.4,65.4) 동체 아래 왼쪽
           E(27.9,63.6) 동체 아래 오른쪽
           F(39.3,73.2) 꼬리 아래 끝 -->
    <Viewbox Stretch="Uniform">
        <Grid Width="96" Height="96">
            <Grid x:Name="Root" Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <!-- 진행 방향(좌/우) 뒤집기 → 회전(기수를 진행 방향으로) -->
                        <ScaleTransform x:Name="Mirror" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="Pitch" Angle="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- ═══ 펼쳐진 종이비행기 ═══ -->
                <Grid x:Name="PlaneLayer">
                    <!-- 그림자: 전체 실루엣을 살짝 아래로 밀어 흐리게 -->
                    <Path Data="M 6,34 L 90,23 L 39.3,73.2 L 27.9,63.6 L 24.4,65.4 L 19.6,42.3 Z"
                          Fill="#3C000000" IsHitTestVisible="False">
                        <Path.RenderTransform>
                            <TranslateTransform X="2" Y="3.4"/>
                        </Path.RenderTransform>
                        <Path.Effect><BlurEffect Radius="5"/></Path.Effect>
                    </Path>

                    <!-- 동체 안쪽 접힌 면(가장 어둡다) -->
                    <Path Data="M 19.6,42.3 L 24.4,65.4 L 27.9,63.6 L 27.9,45.2 Z"
                          Stroke="#16161A" StrokeThickness="2.3" StrokeLineJoin="Round">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#DCE1E9" Offset="0"/>
                                <GradientStop Color="#BAC2CE" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- 기수에서 뻗은 좁은 접힘 면(중간 명암) -->
                    <Path Data="M 90,23 L 19.6,42.3 L 27.9,45.2 Z"
                          Stroke="#16161A" StrokeThickness="2.3" StrokeLineJoin="Round">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EBEEF3" Offset="0"/>
                                <GradientStop Color="#CBD2DC" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- 위쪽 날개(얇고 긴 면) -->
                    <Path Data="M 90,23 L 6,34 L 19.6,42.3 Z"
                          Stroke="#16161A" StrokeThickness="2.3" StrokeLineJoin="Round">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                                <GradientStop Color="#FDFDFF" Offset="0"/>
                                <GradientStop Color="#E4E8EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- 앞쪽 큰 날개(가장 밝다) -->
                    <Path Data="M 90,23 L 39.3,73.2 L 27.9,45.2 Z"
                          Stroke="#16161A" StrokeThickness="2.6" StrokeLineJoin="Round">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.8,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F1F3F7" Offset="0.6"/>
                                <GradientStop Color="#E2E6ED" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Grid>

                <!-- ═══ 구겨진 종이 뭉치(벽에 부딪힌 뒤) ═══ -->
                <Grid x:Name="CrumpledLayer" Visibility="Collapsed">
                    <Path Data="M 30,58 L 22,44 L 33,32 L 51,27 L 66,35 L 72,50 L 66,66 L 50,72 L 36,69 Z"
                          Fill="#3C000000" IsHitTestVisible="False">
                        <Path.RenderTransform>
                            <TranslateTransform X="2" Y="3.4"/>
                        </Path.RenderTransform>
                        <Path.Effect><BlurEffect Radius="5"/></Path.Effect>
                    </Path>

                    <Path Data="M 30,58 L 22,44 L 33,32 L 51,27 L 66,35 L 72,50 L 66,66 L 50,72 L 36,69 Z"
                          Stroke="#16161A" StrokeThickness="2.6" StrokeLineJoin="Round">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                                <GradientStop Color="#FDFDFF" Offset="0"/>
                                <GradientStop Color="#E3E7EE" Offset="0.55"/>
                                <GradientStop Color="#C8CFDA" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- 구겨진 접힘선 -->
                    <Path Data="M 33,32 L 45,47 L 30,58 M 45,47 L 66,35 M 45,47 L 58,60 L 50,72 M 58,60 L 72,50"
                          Stroke="#16161A" StrokeThickness="1.9" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
