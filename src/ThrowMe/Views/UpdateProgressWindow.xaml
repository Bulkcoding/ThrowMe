<Window x:Class="ThrowMe.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrowMe 업데이트"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontFamily="Pretendard, Malgun Gothic">

    <Border CornerRadius="16" Background="{StaticResource WinBg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="26,24,26,24">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#A8F0DD" Offset="0"/>
                            <GradientStop Color="#8B6FD6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="TitleText" Text="업데이트를 받는 중…" Style="{StaticResource H1}"
                           FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 한 줄에 몰아넣으면 창 폭에서 잘려서, 문장을 줄로 나눠 보여준다. -->
            <TextBlock x:Name="SubText" Style="{StaticResource RowDesc}" Margin="0,12,0,0"
                       TextWrapping="Wrap" Text="새 버전으로 업데이트하고 있습니다."/>
            <TextBlock x:Name="SubText2" Style="{StaticResource RowDesc}" Margin="0,4,0,0"
                       TextWrapping="Wrap" Text="끝나면 자동으로 다시 시작합니다."/>

            <ProgressBar x:Name="Bar" Height="6" Margin="0,16,0,0"
                         Minimum="0" Maximum="1" Value="0"
                         Background="{StaticResource TrackBg}"
                         Foreground="{StaticResource Accent}"
                         BorderThickness="0"/>

            <TextBlock x:Name="PercentText" Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                       HorizontalAlignment="Right" Text=""/>
        </StackPanel>
    </Border>
</Window>
